# ============================================
# BFSI Backend - Oracle VM Production Env
# ============================================
# Location on VM: /opt/bfsi-backend/.env.production
# IMPORTANT: Replace ALL placeholder values before starting

NODE_ENV=production
PORT=5000

# MongoDB Atlas (replace with actual credentials)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bfsi-app?retryWrites=true&w=majority

# JWT (generate strong secret: openssl rand -base64 64)
JWT_SECRET=<GENERATE_STRONG_SECRET>
JWT_EXPIRES_IN=1d

# URLs (replace with actual domain)
CLIENT_URL=https://<your-frontend>.vercel.app
API_BASE_URL=https://api.<yourdomain>.com

# CORS (must match frontend URL exactly)
CORS_ORIGIN=https://<your-frontend>.vercel.app

# Logging
LOG_LEVEL=warn

# Rate Limiting (production-strict)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Security
COOKIE_SECRET=<GENERATE_STRONG_SECRET>
BCRYPT_SALT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=15
